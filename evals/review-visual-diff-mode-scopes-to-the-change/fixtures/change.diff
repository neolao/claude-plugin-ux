--- a/src/styles.css
+++ b/src/styles.css
@@ -5,4 +5,13 @@
 
 .legacy-banner { width: 960px; padding: 12px 16px; background: #fff7d6; }
 
+.tag-chip { padding: 2px 8px; border: 1px solid #888; border-radius: 10px; background: #eee; cursor: pointer; }
+.tag-chip:hover { background: #ddd; }
+.tag-chip:focus-visible { outline: 2px solid #1a5fd0; outline-offset: 2px; }
+.tag-chip:active { background: #ccc; }
+
+.member-card { width: 340px; height: 72px; padding: 12px; white-space: nowrap; overflow: hidden; }
+.member-card-name { font-size: 16px; margin: 0; }
+.member-card-role { font-size: 14px; color: #555; margin: 0; }
+
 .page { display: grid; gap: 16px; padding: 24px; }
--- a/src/MemberCard.tsx
+++ b/src/MemberCard.tsx
@@ -0,0 +1,13 @@
+import "./styles.css";
+
+export function MemberCard({ name, role, tags }: { name: string; role: string; tags: string[] }) {
+  return (
+    <article className="member-card">
+      <h3 className="member-card-name">{name}</h3>
+      <p className="member-card-role">{role}</p>
+      {tags.map((t) => (
+        <button key={t} className="tag-chip">{t}</button>
+      ))}
+    </article>
+  );
+}
